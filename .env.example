# Copy to .env.local and fill in. Never commit real secrets.

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (safe for the browser, respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Secret key (SERVER ONLY — bypasses RLS, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# Postgres connection for scripts/db/* (migrations). Use the Session pooler
# URI (IPv4) from Supabase → Connect if the direct host doesn't resolve.
# URL-encode special characters in the password (e.g. @ → %40).
SUPABASE_DB_URL=postgresql://postgres.your-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional ─────────────────────────────────────────────
# Salt for hashing client IPs in rate limits (any long random string).
RATE_LIMIT_SALT=
# Vercel AI Gateway key for optional AI assistance (server only, billable).
AI_GATEWAY_API_KEY=
